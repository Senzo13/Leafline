{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "jsx": "react",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": "./",
    "paths": {
      "@components/*": ["src/components/*"],
      "@utils/*": ["src/utils/*"],
      "@services/*": ["src/services/*"],
      "@assets/*": ["src/assets/*"],
      "@screens/*": ["src/screens/*"],
      "@navigations/*": ["src/navigations/*"],
      "@resources/*": ["src/resources/*"],
      "@types/*": ["src/types/*"],
      "@context/*": ["src/context/*"]
    }
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.spec.tsx",
    "**/*.test.tsx"
  ],
  "include": ["./src/**/*.tsx", "./src/**/*.ts", "src/navigations/nav.tsx"]
}
